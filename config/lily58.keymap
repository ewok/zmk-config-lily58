#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt { flavor = "balanced"; };

&mt {
};

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 54 55 56 57 51 50 52 53>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54 55 56 57>;
            hold-trigger-on-release;
        };

        lt_tap: lt_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        lt_hold: lt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_HOLD";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        rconn {
            bindings = <&mo 2>;
            key-positions = <54 43>;
            timeout-ms = <1500>;
            layers = <0>;
        };

        lconn {
            bindings = <&mo 2>;
            key-positions = <53 42>;
            timeout-ms = <1500>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                           &kp N6     &kp N7    &kp N8     &kp N9   &kp N0     &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                                            &kp Y      &kp U     &kp I      &kp O    &kp P      &kp LBKT
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                                            &kp H      &kp J     &kp K      &kp L    &kp SEMI   &kp RSHFT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B      &kp F5           &kp F8               &kp N      &kp M     &kp COMMA  &kp DOT  &kp SLASH  &kp RCTRL
                           &kp LALT  &kp LGUI  &kp SPACE  &lt_tap 1 RET    &lt_tap 1 BACKSPACE  &kp SPACE  &kp RGUI  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp GRAVE  &kp N6  &kp N7  &kp N8     &kp N9   &kp N0                      &trans  &trans  &trans  &trans  &trans  &trans
&kp CAPS   &kp Y   &kp U   &kp I      &kp O    &kp P                       &trans  &trans  &trans  &trans  &trans  &trans
&kp LBKT   &kp H   &kp J   &kp K      &kp L    &kp SEMI                    &trans  &trans  &trans  &trans  &trans  &trans
&kp RBKT   &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp F8    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &kp BSPC   &trans   &trans    &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        connect {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                   &none   &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
&none         &none         &none         &none         &none         &none                   &none   &none         &none         &none         &none         &none
&none         &none         &none         &none         &bt BT_CLR    &none                   &none   &bt BT_CLR    &none         &none         &none         &none
&none         &none         &none         &none         &none         &none   &none    &none  &none   &none         &none         &none         &none         &none
                                          &trans        &trans        &trans  &none    &none  &trans  &none         &none
            >;
        };
    };
};
